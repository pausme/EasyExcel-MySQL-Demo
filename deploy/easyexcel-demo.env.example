# EasyExcel Demo production runtime example.
# Copy this file outside the repository as .env and replace placeholder values.
# Do not commit real passwords, tokens, access keys, or public endpoints.

# Application
SERVER_PORT=18088
TZ=Asia/Shanghai
JAVA_OPTS=-Xms512m -Xmx1536m -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# MySQL: when app and middleware are in the same docker compose project, use mysql:3306.
MYSQL_URL=mysql:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=<CHANGE_ME>
HIKARI_MAXIMUM_POOL_SIZE=10

# Redis: when app and middleware are in the same docker compose project, use redis:6379.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# Security
API_SECURITY_INIT_ENABLED=true
API_SECURITY_DEMO_MODE=false
API_SECURITY_DEMO_USER_TOKEN=<CHANGE_ME_USER_TOKEN>
API_SECURITY_DEMO_ADMIN_TOKEN=<CHANGE_ME_ADMIN_TOKEN>
API_SECURITY_JWT_SECRET=<CHANGE_ME_AT_LEAST_32_CHARS>
API_SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_SECURITY_REFRESH_TOKEN_EXPIRE_MINUTES=10080
API_SECURITY_BOOTSTRAP_ADMIN_ENABLED=false
API_SECURITY_BOOTSTRAP_ADMIN_USER_ID=admin
API_SECURITY_BOOTSTRAP_ADMIN_USERNAME=
API_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=

# Flyway. Enable Flyway in production after confirming baseline state.
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

# MinIO: internal endpoint is used by the application; public endpoint is used in signed download URLs.
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://<PUBLIC_HOST>:7000
MINIO_ACCESS_KEY=<CHANGE_ME>
MINIO_SECRET_KEY=<CHANGE_ME>
MINIO_BUCKET_NAME=student-excel
MINIO_EXPORT_OBJECT_PREFIX=excel/student
MINIO_IMPORT_SOURCE_OBJECT_PREFIX=excel/student/import-source
MINIO_IMPORT_ERROR_OBJECT_PREFIX=excel/student/import-error
MINIO_DOWNLOAD_URL_EXPIRE_MINUTES=30
MINIO_LIFECYCLE_ENABLED=true
MINIO_LIFECYCLE_EXPIRE_DAYS=1
MINIO_IMPORT_SOURCE_RETENTION_DAYS=1
MINIO_CONNECT_TIMEOUT_MILLIS=3000
MINIO_WRITE_TIMEOUT_MILLIS=60000
MINIO_READ_TIMEOUT_MILLIS=60000
MINIO_MAX_RETRY_TIMES=2
MINIO_RETRY_BACKOFF_MILLIS=200

# Excel import/export tuning
EXPORT_PAGE_SIZE=5000
EXPORT_CORE_POOL_SIZE=2
EXPORT_MAX_POOL_SIZE=2
EXPORT_QUEUE_CAPACITY=10
EXPORT_AWAIT_TERMINATION_SECONDS=30
EXPORT_REJECTED_EXECUTION_POLICY=abort
IMPORT_BATCH_SIZE=2000
IMPORT_MAX_ROWS_PER_TASK=200000
IMPORT_MAX_FILE_SIZE_FOR_ASYNC=104857600
IMPORT_MERGE_CHUNK_SIZE=5000
IMPORT_WORKER_COUNT=4
IMPORT_MAX_CONCURRENT_TASKS=1
IMPORT_QUEUE_CAPACITY=20
IMPORT_EXECUTOR_QUEUE_CAPACITY=20
IMPORT_TASK_CORE_POOL_SIZE=1
IMPORT_TASK_MAX_POOL_SIZE=1
IMPORT_TASK_QUEUE_CAPACITY=10
IMPORT_AWAIT_TERMINATION_SECONDS=30
IMPORT_WORKER_FINISH_WAIT_SECONDS=0
IMPORT_TRANSACTION_TIMEOUT_SECONDS=60
IMPORT_MAX_RETRY_TIMES=3
IMPORT_RETRY_BACKOFF_MILLIS=200
IMPORT_PROGRESS_LOG_INTERVAL=50
IMPORT_BATCH_SORT_ENABLED=true

# Task center
TASK_CENTER_INIT_ENABLED=true
TASK_CENTER_REDIS_KEY_PREFIX=task:center:
TASK_CENTER_CACHE_RETENTION_HOURS=24
TASK_CENTER_MAX_PAGE_SIZE=100
TASK_CENTER_DEFAULT_OWNER_ID=anonymous
TASK_CENTER_MAX_RETRY_COUNT=3
TASK_CENTER_MAX_ACTIVE_TASKS_PER_OWNER=10
TASK_CENTER_MAX_ACTIVE_TASKS_TOTAL=50
TASK_RECOVERY_ENABLED=true
TASK_WORKER_ID=
TASK_RECOVERY_HEARTBEAT_TIMEOUT_SECONDS=120
TASK_RECOVERY_BATCH_SIZE=20
TASK_RECOVERY_INITIAL_DELAY_MILLIS=30000
TASK_RECOVERY_FIXED_DELAY_MILLIS=60000
TASK_RECOVERY_LOCK_KEY=task:recovery:lock
TASK_RECOVERY_LOCK_TTL_SECONDS=300
TASK_EXECUTION_LOCK_KEY_PREFIX=task:execution:
TASK_EXECUTION_LOCK_TTL_SECONDS=3600

# File center
FILE_CENTER_INIT_ENABLED=true
FILE_CENTER_OBJECT_PREFIX=files/general
FILE_CENTER_MULTIPART_OBJECT_PREFIX=files/multipart
FILE_CENTER_DOWNLOAD_URL_EXPIRE_MINUTES=30
FILE_CENTER_UPLOAD_URL_EXPIRE_MINUTES=30
FILE_CENTER_MULTIPART_PART_SIZE=8388608
FILE_CENTER_MULTIPART_MAX_PART_COUNT=1000
FILE_CENTER_MAX_PAGE_SIZE=100
FILE_CENTER_MAX_FILE_SIZE_BYTES=0
FILE_CENTER_MAX_TOTAL_STORAGE_BYTES_PER_OWNER=0
FILE_CENTER_MAX_ACTIVE_UPLOAD_TASKS_PER_OWNER=20
FILE_CENTER_MAX_DAILY_UPLOAD_COUNT_PER_OWNER=0
FILE_CENTER_RECONCILIATION_ENABLED=true
FILE_CENTER_RECONCILIATION_INITIAL_DELAY_MILLIS=600000
FILE_CENTER_RECONCILIATION_FIXED_DELAY_MILLIS=3600000
FILE_CENTER_RECONCILIATION_BATCH_SIZE=200
FILE_CENTER_RECONCILIATION_UPLOAD_STALE_HOURS=24
FILE_CENTER_CORS_ENABLED=true
FILE_CENTER_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
FILE_CENTER_SECURITY_SCAN_ENABLED=true

# Cleanup
DATA_CLEANUP_ENABLED=true
DATA_CLEANUP_INITIAL_DELAY_MILLIS=300000
DATA_CLEANUP_FIXED_DELAY_MILLIS=3600000
DATA_CLEANUP_BATCH_SIZE=200
DATA_CLEANUP_TASK_RETENTION_HOURS=168
DATA_CLEANUP_UPLOAD_TASK_RETENTION_HOURS=24
DATA_CLEANUP_DELETED_FILE_RETENTION_HOURS=24
DATA_CLEANUP_IMPORT_STAGE_RETENTION_HOURS=24
DATA_CLEANUP_IMPORT_VERSION_CLEANUP_ENABLED=true
DATA_CLEANUP_IMPORT_VERSION_RETAIN_COUNT=2
DATA_CLEANUP_DISTRIBUTED_LOCK_ENABLED=true
DATA_CLEANUP_LOCK_KEY=cleanup:retention:lock
DATA_CLEANUP_LOCK_TTL_SECONDS=1800
